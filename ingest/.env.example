# Convex HTTP actions base URL (deployment "site" domain)
CONVEX_SITE_URL=https://your-deployment.convex.site

# Shared secret; must match the INGEST_SECRET environment variable
# configured on the Convex deployment (`npx convex env set INGEST_SECRET ...`)
INGEST_SECRET=change-me-to-a-long-random-string

# Optional: Convex functions API base URL (used for public queries like due sessions)
CONVEX_URL=https://your-deployment.convex.cloud

# Optional: FastF1 cache directory
FASTF1_CACHE=~/.cache/fastf1
